{
  "info": {
    "name": "Sistema Control de Inventarios API",
    "description": "Complete Postman collection for the inventory management system. All routes live under http://localhost:3000. Auth uses OAuth2 password grant. Run the `OAuth token` request first to obtain an access token, then use it as Bearer on all subsequent requests.\n\nSeeded credentials:\n- Client: clientId1 / clientSecret1\n- Users: betolafarc (email: ragest031@gmail.com / pass: ou260802) or user01..user04 (emails user01@hotmail.com .. user04@hotmail.com / pass: password)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {"key": "baseUrl", "value": "http://localhost:3000"},
    {"key": "apiPrefix", "value": "/api/v1"},
    {"key": "clientId", "value": "clientId1"},
    {"key": "clientSecret", "value": "clientSecret1"},
    {"key": "userEmail", "value": "ragest031@gmail.com"},
    {"key": "userPassword", "value": "ou260802"},
    {"key": "accessToken", "value": ""},
    {"key": "userId", "value": ""},
    {"key": "brandId", "value": ""},
    {"key": "categoryId", "value": ""},
    {"key": "measureUnitId", "value": ""},
    {"key": "productId", "value": ""},
    {"key": "supplierId", "value": ""},
    {"key": "taxId", "value": ""},
    {"key": "inventoryId", "value": ""},
    {"key": "inventoryMemberId", "value": ""},
    {"key": "warehouseId", "value": ""},
    {"key": "warehouseMemberId", "value": ""}
  ],
  "item": [
    {
      "name": "0 · Setup",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/",
              "host": ["{{baseUrl}}"],
              "path": [""]
            }
          }
        }
      ]
    },
    {
      "name": "1 · Authentication",
      "item": [
        {
          "name": "Register user",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"email\": \"newuser@test.com\",\n    \"password\": \"password123\",\n    \"username\": \"newuser\",\n    \"firstname\": \"New\",\n    \"lastname\": \"User\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}{{apiPrefix}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["{{apiPrefix}}", "auth", "register"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const json = pm.response.json();",
                  "    if (json.user?.id) pm.collectionVariables.set('userId', json.user.id);",
                  "    console.log('New user registered. userId =', json.user?.id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "OAuth token (password grant)",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/x-www-form-urlencoded"}
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {"key": "grant_type", "value": "password"},
                {"key": "client_id", "value": "{{clientId}}"},
                {"key": "client_secret", "value": "{{clientSecret}}"},
                {"key": "username", "value": "{{userEmail}}"},
                {"key": "password", "value": "{{userPassword}}"}
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/oauth/token",
              "host": ["{{baseUrl}}"],
              "path": ["oauth", "token"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const json = pm.response.json();",
                  "    if (json.accessToken) pm.collectionVariables.set('accessToken', json.accessToken);",
                  "    if (json.user?.id) pm.collectionVariables.set('userId', json.user.id);",
                  "    console.log('Got accessToken. userId =', json.user?.id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}{{apiPrefix}}/auth/logout",
              "host": ["{{baseUrl}}"],
              "path": ["{{apiPrefix}}", "auth", "logout"]
            }
          }
        }
      ]
    },
